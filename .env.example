MARIADB_DATABASE=homehub
MARIADB_USER=homehub
MARIADB_PASSWORD=replace-with-a-local-development-password
MARIADB_ROOT_PASSWORD=replace-with-a-different-root-password
MARIADB_HOST_PORT=3307
HOST_AGENT_BASE_URL=http://host.docker.internal:9101
HOST_AGENT_TOKEN=replace-with-the-same-agent-token
HOST_AGENT_CONNECT_TIMEOUT=2s
HOST_AGENT_READ_TIMEOUT=3s
SYNOLOGY_BASE_URL=https://nas.example.com
SYNOLOGY_CONNECT_TIMEOUT=2s
SYNOLOGY_READ_TIMEOUT=5s
